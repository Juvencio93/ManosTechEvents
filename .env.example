# Supabase — copie este arquivo para .env e preencha com seus valores reais
# Obtenha em: https://app.supabase.com → seu projeto → Settings → API

VITE_SUPABASE_URL=https://<seu-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<sua-anon-key-publica>

# Opcional — alias aceito pelo portal.html como fallback
# VITE_SUPABASE_PUBLISHABLE_KEY=<mesma-anon-key>
